{
  "manifest_version": 3,
  "name": "Aistim Tool",
  "version": "2.5.3",
  "description": "AI Userscript Manager — auto-load dari folder scripts/ GitHub, userScripts engine (CSP-safe)",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab", "userScripts"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Aistim Tool — Userscript Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
